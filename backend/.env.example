NODE_ENV=development
PORT=4000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=online_academy
DB_SSL=false
SESSION_SECRET=
JWT_SECRET=
SESSION_COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:4000,http://localhost:5173
# Root npm start enables this automatically after npm run build.
SERVE_CLIENT=false

# Local RAG chatbot (the first message synchronizes public courses and Markdown guides).
OLLAMA_URL=http://127.0.0.1:11434
CHAT_MODEL=qwen3:4b
EMBEDDING_MODEL=qwen3-embedding:0.6b
CHATBOT_TIMEOUT_MS=180000
# Embeddings are stored in PostgreSQL/Supabase via DB_* above (vector(1024)).
