NODE_ENV=development
PORT=4000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=online_academy
DB_SSL=false
SESSION_SECRET=
JWT_SECRET=
SESSION_COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:4000,http://localhost:5173
# Root npm start enables this automatically after npm run build.
SERVE_CLIENT=false

# RAG chatbot: Groq generates answers; Cloudflare Workers AI creates multilingual embeddings.
# Keep all API credentials in backend/.env locally and the Render backend environment.
GROQ_API_KEY=
CHAT_MODEL=qwen/qwen3.8-27b
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
EMBEDDING_MODEL=@cf/baai/bge-m3
CHATBOT_TIMEOUT_MS=180000
# Embeddings are stored in PostgreSQL/Supabase via DB_* above (vector(1024)).
