  "main": "src/app.js",
  "scripts": {
    "test": "npm run check && npm run test:unit && npm run test:api",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node scripts/validate.js",
    "test:unit": "cross-env NODE_ENV=test node --test tests/unit/validators.test.js",
    "test:api": "cross-env NODE_ENV=test node --test tests/api/*.test.js",
    "db:migrate": "node scripts/migrate.js",
    "db:rollback": "knex migrate:rollback",
    "db:seed": "knex seed:run"
  },
