    <section class="content-section category-section">
    <div class="section-heading">
        <div>
            <span class="section-kicker">Danh mục</span>
            <h2>Lĩnh vực được đăng ký nhiều nhất tuần</h2>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-7">
            <ul class="list-group list-group-flush top-category-list">
                {{#each topCategories}}
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <a href="/categories/{{this.id}}" class="text-decoration-none fw-bold">
                        {{this.catname}}
                    </a>
                    <span class="badge rounded-pill">{{this.enroll_count}} lượt đăng ký</span>
                </li>
                {{/each}}
            </ul>
        </div>
        <div class="col-lg-5 mt-4 mt-lg-0">
            <div class="category-cta">
                <span>Instructor workspace</span>
                <h3>Bán khóa học và quản lý học viên trong cùng hệ thống.</h3>
                <a href="/instructor" class="btn btn-success">
                    <i class="bi bi-easel2" aria-hidden="true"></i>
                    Kênh giảng viên
                </a>
            </div>
        </div>
    </div>
    </section>

</div>
