<div class="home-page py-4">
    <section class="hero-brand mb-4" aria-labelledby="home-hero-title">
        <div class="hero-content">
            <span class="hero-kicker">Academy commerce platform</span>
            <h1 id="home-hero-title">Online Academy</h1>
            <p class="hero-lead">Khám phá khóa học chất lượng, mua nhanh như một online shop và bắt đầu học ngay trong tài khoản của bạn.</p>

            <form class="hero-search" role="search" action="/search" method="get">
                <label class="visually-hidden" for="hero-search-input">Tìm khóa học</label>
                <i class="bi bi-search" aria-hidden="true"></i>
                <input id="hero-search-input" type="search" name="q" placeholder="Tìm khóa học, kỹ năng, giảng viên..." autocomplete="off">
                <button class="btn btn-primary" type="submit">Tìm kiếm</button>
            </form>

            <div class="hero-actions">
                <a href="/courses" class="btn btn-primary btn-lg">
                    <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i>
                    Khóa học
                </a>
                <a href="/account/signup" class="btn btn-outline-primary btn-lg">
                    <i class="bi bi-person-plus" aria-hidden="true"></i>
                    Tạo tài khoản
                </a>
            </div>
        </div>

        <div class="hero-panel" aria-label="Tổng quan học tập">
            <div class="hero-panel-header">
                <div>
                    <span>Learning console</span>
                    <strong>Dashboard</strong>
                </div>
                <i class="bi bi-bar-chart-line" aria-hidden="true"></i>
            </div>
            <div class="metric-grid">
                <div>
                    <strong>10+</strong>
                    <span>Nổi bật</span>
                </div>
                <div>
                    <strong>10+</strong>
                    <span>Mới nhất</span>
                </div>
                <div>
                    <strong>5</strong>
                    <span>Lĩnh vực</span>
                </div>
            </div>
            <div class="learning-path">
                <div class="path-row active">
                    <span></span>
                    <p>Chọn khóa học phù hợp</p>
                </div>
                <div class="path-row">
                    <span></span>
                    <p>Thanh toán và lưu vào thư viện</p>
                </div>
                <div class="path-row">
                    <span></span>
                    <p>Theo dõi tiến độ học</p>
                </div>
            </div>
        </div>
    </section>

    <section class="quick-stats mb-5" aria-label="Điểm nổi bật">
        <div>
            <i class="bi bi-mortarboard" aria-hidden="true"></i>
            <strong>Học theo lộ trình</strong>
            <span>Bài giảng, quiz và tiến độ trong một nơi.</span>
        </div>
        <div>
            <i class="bi bi-bag-check" aria-hidden="true"></i>
            <strong>Mua khóa học nhanh</strong>
            <span>Giỏ hàng rõ ràng, giá khuyến mãi nổi bật.</span>
        </div>
        <div>
            <i class="bi bi-stars" aria-hidden="true"></i>
            <strong>Xếp hạng minh bạch</strong>
            <span>Rating và lượt đánh giá hiển thị ngay trên card.</span>
        </div>
    </section>

    <section class="content-section">
    <div class="section-heading">
        <div>
            <span class="section-kicker">Đề xuất tuần này</span>
            <h2>Khóa học nổi bật</h2>
        </div>
        <a href="/courses" class="section-link">Xem tất cả <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
    </div>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-4">
        {{#each outstandingCourses}}
        <div class="col">
            <div class="card course-card h-100">

                <img src="{{this.thumbnail}}" class="card-img-top" alt="{{this.title}}">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title text-truncate">{{this.title}}</h5>

                    {{#if this.short_desc}}
                    <p class="card-text text-muted small text-truncate-2">{{this.short_desc}}</p>
                    {{/if}}

                    <p class="card-text text-muted small mb-1">
                        Lĩnh vực: <strong>{{this.category}}</strong>
                    </p>
                    <p class="card-text text-muted small mb-1">
                        Giảng viên: <strong>{{this.instructor_name}}</strong>
                    </p>

                    <div class="d-flex align-items-center mb-1">
                        <span class="fw-bold text-warning me-1">{{this.rating_avg}}</span>
                        {{{generateStars this.rating_avg}}}
                        <span class="text-muted ms-1 small">({{this.rating_count}})</span>
                    </div>

                    <div class="mt-auto">
                        <div>
                            {{#if this.sale_price}}
                            <span class="price-now fs-5">{{formatVnd this.sale_price}}</span>
                            <span class="price-old ms-1 small">{{formatVnd this.price}}</span>
                            {{else}}
                            <span class="price-now fs-5">{{formatVnd this.price}}</span>
                            {{/if}}
                        </div>

                        <div class="d-flex align-items-center mt-2 gap-2">
                            {{#if_contains ../ownedCourseIds this.id}}
                            <a href="/student/courses" class="btn btn-outline-primary btn-sm w-100">
                                <i class="bi bi-play-circle"></i> Vào học
                            </a>
                            {{else}}
                            <form action="/cart/add" method="POST" style="flex-grow: 1;">
                                <input type="hidden" name="course_id" value="{{this.id}}">
                                <button type="submit" class="btn btn-success btn-sm w-100">
                                    <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                                </button>
                            </form>
                            {{/if_contains}}

                            <a href="/courses/{{this.id}}" class="btn btn-outline-primary btn-sm" title="Xem chi tiết">
                                <i class="bi bi-info-circle"></i>
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        {{/each}}
    </div>

    </section>

