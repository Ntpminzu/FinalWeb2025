{
  "name": "finalweb2025-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "install:backend": "npm --prefix backend ci",
    "install:client": "npm --prefix client ci",
    "start": "node scripts/start.mjs",
    "start:backend": "npm --prefix backend start",
    "dev": "node scripts/dev.mjs",
    "dev:backend": "npm --prefix backend run dev",
    "dev:client": "npm --prefix client run dev",
    "dev:demo": "node scripts/dev.mjs --demo",
    "build": "npm --prefix client run build",
    "check": "npm --prefix backend run check",
    "test": "npm --prefix backend test && npm --prefix client test",
    "test:e2e": "npm --prefix client run test:e2e",
    "test:unit": "npm --prefix backend run test:unit",
    "test:api": "npm --prefix backend run test:api",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:rollback": "npm --prefix backend run db:rollback",
    "db:seed": "npm --prefix backend run db:seed"
  }
}
