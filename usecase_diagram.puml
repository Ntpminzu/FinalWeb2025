@startuml Online_Academy_UseCase

left to right direction
skinparam usecaseFontSize 11
skinparam rectangleFontSize 16
skinparam rectangleFontStyle bold

' --- ACTORS BÊN TRÁI ---
actor "Guest" as Guest
actor "Student" as Student
Guest <|-- Student

' --- ACTORS BÊN PHẢI ---
actor "Instructor" as Instructor
actor "Admin" as Admin
actor "Email\nSystem" as EmailSys <<System>>

rectangle "Online Academy" {

  ' ======== CỘT 1: Auth + Browse (gần Guest) ========
  together {
    usecase "Register" as UC01
    usecase "Log in" as UC02
    usecase "Log out" as UC11
    usecase "View Homepage" as UC03
    usecase "View Course List" as UC04
    usecase "View Course\nDetails" as UC05
  }

  ' ======== CỘT 2: Search + Cart ========
  together {
    usecase "View Courses\nby Category" as UC06
    usecase "Search Course" as UC07
    usecase "Add to Cart" as UC08
    usecase "View Cart" as UC09
    usecase "Remove from Cart" as UC10
    usecase "Checkout" as UC15
  }

  ' ======== CỘT 3: Learning + Watchlist (gần Student) ========
  together {
    usecase "View Profile" as UC12
    usecase "Update Profile" as UC13
    usecase "Change Password" as UC14
    usecase "View Purchased\nCourses" as UC16
    usecase "Watch Lecture" as UC18
    usecase "Review Course" as UC23
  }

  ' ======== CỘT 4: Watchlist + Include/Extend targets ========
  together {
    usecase "View Watchlist" as UC21
    usecase "Add to Watchlist" as UC20
    usecase "Remove from\nWatchlist" as UC22
    usecase "Save Progress" as UC19
    usecase "Verify OTP" as OTP
    usecase "Send OTP Email" as SendOTP
  }

  ' ======== CỘT 5: Instructor features ========
  together {
    usecase "View Instructor\nDashboard" as UC25
    usecase "Create Course" as UC26
    usecase "Edit Course" as UC27
    usecase "Toggle Course\nStatus" as UC28
    usecase "Manage Lectures" as UC29
    usecase "Add Lecture" as UC30
    usecase "Delete Lecture" as UC31
    usecase "View Instructor\nProfile" as UC32
    usecase "Edit Instructor\nProfile" as UC33
  }

  ' ======== CỘT 6: Admin features ========
  together {
    usecase "View Admin\nDashboard" as UC35
    usecase "Manage Users" as UC36
    usecase "Promote to\nInstructor" as UC37
    usecase "Disable/Enable\nAccount" as UC38
    usecase "Delete User" as UC39
    usecase "Manage Courses" as UC40
    usecase "Delete Course" as UC41
    usecase "Disable/Enable\nCourse" as UC42
    usecase "Manage\nCategories" as UC43
    usecase "Add Category" as UC44
    usecase "Edit Category" as UC45
    usecase "Delete Category" as UC46
  }

  ' --- Hidden links để tạo khoảng cách giữa các cột ---
  UC01 -[hidden]right-> UC06
  UC02 -[hidden]right-> UC07
  UC04 -[hidden]right-> UC08

  UC06 -[hidden]right-> UC12
  UC07 -[hidden]right-> UC13
  UC15 -[hidden]right-> UC16

  UC12 -[hidden]right-> UC21
  UC14 -[hidden]right-> OTP
  UC16 -[hidden]right-> UC19

  UC21 -[hidden]right-> UC25
  OTP -[hidden]right-> UC26
  UC20 -[hidden]right-> UC27

  UC25 -[hidden]right-> UC35
  UC26 -[hidden]right-> UC36
  UC29 -[hidden]right-> UC40
}

' ============ GUEST (trái) ============
Guest --> UC01
Guest --> UC02
Guest --> UC03
Guest --> UC04
Guest --> UC05
Guest --> UC06
Guest --> UC07
Guest --> UC08
Guest --> UC09
Guest --> UC10

' ============ STUDENT (trái) ============
Student --> UC11
Student --> UC12
Student --> UC13
Student --> UC14
Student --> UC15
Student --> UC16
Student --> UC18
Student --> UC20
Student --> UC21
Student --> UC22
Student --> UC23

' ============ INSTRUCTOR (phải) ============
UC11 <-- Instructor
UC25 <-- Instructor
UC26 <-- Instructor
UC27 <-- Instructor
UC28 <-- Instructor
UC29 <-- Instructor
UC32 <-- Instructor
UC33 <-- Instructor

' ============ ADMIN (phải) ============
UC11 <-- Admin
UC35 <-- Admin
UC36 <-- Admin
UC40 <-- Admin
UC43 <-- Admin

' ============ EMAIL SYSTEM (phải) ============
SendOTP --> EmailSys

' ============ <<include>> ============
UC01 ..> OTP : <<include>>
UC01 ..> SendOTP : <<include>>
UC18 ..> UC19 : <<include>>

' ============ <<extend>> ============
UC05 <.. UC08 : <<extend>>
UC05 <.. UC20 : <<extend>>
UC04 <.. UC07 : <<extend>>
UC30 ..> UC29 : <<extend>>
UC31 ..> UC29 : <<extend>>
UC37 ..> UC36 : <<extend>>
UC38 ..> UC36 : <<extend>>
UC39 ..> UC36 : <<extend>>
UC41 ..> UC40 : <<extend>>
UC42 ..> UC40 : <<extend>>
UC44 ..> UC43 : <<extend>>
UC45 ..> UC43 : <<extend>>
UC46 ..> UC43 : <<extend>>

@enduml
