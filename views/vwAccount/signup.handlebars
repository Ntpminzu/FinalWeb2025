{{#fillContent 'js'}}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.querySelector('#frmSignup').addEventListener('submit', handleSubmit);

    async function handleSubmit(e) {
        e.preventDefault();

        const username = document.querySelector('#txtUsername').value.trim();
        const password = document.querySelector('#txtPassword').value;
        const confirm = document.querySelector('#txtConfirm').value;
        const email = document.querySelector('#txtEmail').value.trim();

        if (!username) {
            Swal.fire({ title: 'Thiếu thông tin', text: 'Vui lòng nhập tên đăng nhập!', icon: 'warning', confirmButtonText: 'OK' });
            return;
        }
        if (password.length < 6) {
            Swal.fire({ title: 'Mật khẩu quá ngắn', text: 'Mật khẩu phải ít nhất 6 ký tự!', icon: 'error', confirmButtonText: 'OK' });
            return;
        }
        if (password !== confirm) {
            Swal.fire({ title: 'Mật khẩu không khớp', text: 'Vui lòng nhập lại cho đúng!', icon: 'error', confirmButtonText: 'OK' });
            return;
        }
        if (!email.includes('@')) {
            Swal.fire({ title: 'Email không hợp lệ', text: 'Vui lòng nhập đúng định dạng email!', icon: 'error', confirmButtonText: 'OK' });
            return;
        }

        // Kiểm tra username có bị trùng không
        try {
            const res = await fetch(`/account/is-available?u=${encodeURIComponent(username)}`);
            const data = await res.json();
            if (data === false) {
                Swal.fire({ title: 'Tên đăng nhập đã tồn tại', text: 'Vui lòng chọn tên khác!', icon: 'error', confirmButtonText: 'OK' });
                return;
            }
            e.target.submit();
        } catch (err) {
            console.error(err);
            Swal.fire({ title: 'Lỗi hệ thống', text: 'Không thể kiểm tra tài khoản. Vui lòng thử lại!', icon: 'error', confirmButtonText: 'OK' });
        }
    }
</script>
{{/fillContent}}

<div class="row justify-content-center my-4">
    <div class="col-12 col-md-9 col-lg-7">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">

            <div class="card-header bg-primary text-white text-center py-3">
                <i class="bi bi-person-plus-fill fs-3 d-block mb-1"></i>
                <h5 class="mb-0 fw-bold">Đăng ký tài khoản học viên</h5>
            </div>

            <div class="card-body p-4">

                {{#if emailExist}}
                <div class="alert alert-danger d-flex align-items-center" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <div>Email này đã được đăng ký. Vui lòng dùng email khác.</div>
                </div>
                {{/if}}
                {{#if message}}
                <div class="alert alert-danger d-flex align-items-center" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <div>{{message}}</div>
                </div>
                {{/if}}

                <form id="frmSignup" method="post" action="/account/signup" novalidate>

                    <h6 class="text-primary fw-bold text-uppercase small mb-3">
                        <i class="bi bi-shield-lock me-1"></i> Thông tin tài khoản
                    </h6>

                    <div class="mb-3">
                        <label for="txtUsername" class="form-label fw-semibold">Tên đăng nhập</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input type="text" class="form-control" id="txtUsername" name="username"
                                value="{{username}}" placeholder="Nhập tên đăng nhập...">
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="txtPassword" class="form-label fw-semibold">Mật khẩu</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-key"></i></span>
                                <input type="password" class="form-control" id="txtPassword" name="password"
                                    placeholder="Ít nhất 6 ký tự">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="txtConfirm" class="form-label fw-semibold">Xác nhận mật khẩu</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                                <input type="password" class="form-control" id="txtConfirm" name="confirm_password"
                                    placeholder="Nhập lại mật khẩu...">
                            </div>
                        </div>
                    </div>
                    <div class="form-text mb-2">Mật khẩu tối thiểu 6 ký tự.</div>

                    <hr class="my-4">

                    <h6 class="text-primary fw-bold text-uppercase small mb-3">
                        <i class="bi bi-person-vcard me-1"></i> Thông tin cá nhân
                    </h6>

                    <div class="mb-3">
                        <label for="txtName" class="form-label fw-semibold">Họ và tên</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-card-text"></i></span>
                            <input type="text" class="form-control" id="txtName" name="name"
                                value="{{name}}" placeholder="Nguyễn Văn A">
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-7">
                            <label for="txtEmail" class="form-label fw-semibold">Địa chỉ Email</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input type="email" class="form-control" id="txtEmail" name="email"
                                    value="{{email}}" placeholder="example@gmail.com">
                            </div>
                        </div>
                        <div class="col-md-5">
                            <label for="txtDoB" class="form-label fw-semibold">Ngày sinh</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-calendar-event"></i></span>
                                <input type="date" class="form-control" id="txtDoB" name="dob" value="{{dob}}">
                            </div>
                        </div>
                    </div>

                    <!-- Ẩn role cố định -->
                    <input type="hidden" name="role" value="user">

                    <p class="text-muted fst-italic small mt-3 mb-0">
                        <i class="bi bi-info-circle me-1"></i>
                        Tài khoản mới mặc định là <b>học viên</b>. Giảng viên và quản trị viên do admin cấp.
                    </p>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary flex-fill fw-semibold">
                            <i class="bi bi-person-fill-add me-1"></i> Đăng ký
                        </button>
                        <button type="reset" class="btn btn-outline-secondary flex-fill">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> Làm mới
                        </button>
                    </div>

                    <a href="/" class="btn btn-link w-100 mt-2 text-decoration-none">
                        <i class="bi bi-house-door me-1"></i> Quay lại trang chủ
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>
