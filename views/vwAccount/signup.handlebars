<div class="card auth-card mx-auto my-4">
  <h1 class="h5 card-header bg-primary text-white fw-bold text-center py-3">Đăng ký tài khoản học viên</h1>
  <div class="card-body px-4 py-4">
    {{#if systemError}}
    <div class="alert alert-danger" role="alert">{{message}}</div>
    {{/if}}
    <form id="frmSignup" method="post" action="/account/signup">
      <div class="mb-3">
        <label for="txtUsername" class="form-label fw-semibold">Tên đăng nhập</label>
        <input type="text" class="form-control" id="txtUsername" name="username" value="{{form.username}}"
          pattern="[A-Za-z0-9._-]{3,32}" minlength="3" maxlength="32" autocomplete="username" required
          aria-describedby="usernameHelp">
        <div id="usernameHelp" class="form-text">3–32 ký tự; dùng chữ, số, dấu chấm, gạch dưới hoặc gạch ngang.</div>
      </div>
      <div class="mb-3">
        <label for="txtPassword" class="form-label fw-semibold">Mật khẩu</label>
        <input type="password" class="form-control" id="txtPassword" name="password" minlength="8" maxlength="72"
          autocomplete="new-password" required>
        <div class="form-text">Tối thiểu 8 ký tự.</div>
      </div>
      <div class="mb-3">
        <label for="txtConfirm" class="form-label fw-semibold">Xác nhận mật khẩu</label>
        <input type="password" class="form-control" id="txtConfirm" name="confirm_password" minlength="8" maxlength="72"
          autocomplete="new-password" required>
        <div class="invalid-feedback">Mật khẩu xác nhận chưa khớp.</div>
      </div>
      <h2 class="h5 mt-4 mb-3 text-primary fw-bold">Thông tin cá nhân</h2>
      <div class="mb-3">
        <label for="txtName" class="form-label fw-semibold">Họ và tên</label>
        <input type="text" class="form-control" id="txtName" name="name" value="{{form.name}}" minlength="2" maxlength="100" autocomplete="name" required>
      </div>
      <div class="mb-3">
        <label for="txtEmail" class="form-label fw-semibold">Địa chỉ email</label>
        <input type="email" class="form-control" id="txtEmail" name="email" value="{{form.email}}" maxlength="254" autocomplete="email" required>
        <div class="form-text">Email được dùng để nhận thông báo tài khoản.</div>
      </div>
      <div class="mb-3">
        <label for="txtDoB" class="form-label fw-semibold">Ngày sinh</label>
        <input type="date" class="form-control" id="txtDoB" name="dob" value="{{form.dob}}" autocomplete="bday">
      </div>
      <p class="text-muted small">Tài khoản mới mặc định là học viên. Quyền giảng viên và quản trị viên chỉ được cấp bởi admin.</p>
      <button type="submit" class="btn btn-primary w-100"><i class="bi bi-person-fill-add me-1"></i>Đăng ký</button>
      <p class="text-center text-muted small mt-3 mb-0">Đã có tài khoản? <a href="/account/signin">Đăng nhập</a></p>
    </form>
  </div>
</div>

{{#fillContent 'js'}}
<script>
  (() => {
    const form = document.getElementById('frmSignup');
    const username = document.getElementById('txtUsername');
    const password = document.getElementById('txtPassword');
    const confirmation = document.getElementById('txtConfirm');
    const validatePassword = () => confirmation.setCustomValidity(
      confirmation.value && confirmation.value !== password.value ? 'Mật khẩu không khớp.' : ''
    );
    password.addEventListener('input', validatePassword);
    confirmation.addEventListener('input', validatePassword);
    form.addEventListener('submit', async event => {
      validatePassword();
      if (!form.checkValidity()) { event.preventDefault(); form.classList.add('was-validated'); return; }
      event.preventDefault();
      try {
        const response = await fetch(`/account/is-available?u=${encodeURIComponent(username.value.trim())}`);
        if (!response.ok || !(await response.json())) {
          username.setCustomValidity('Tên đăng nhập đã tồn tại hoặc không hợp lệ.');
          username.reportValidity();
          return;
        }
        username.setCustomValidity('');
        form.submit();
      } catch {
        form.submit();
      }
    });
  })();
</script>
{{/fillContent}}
