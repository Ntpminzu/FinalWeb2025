<section class="auth-card mx-auto py-4 py-lg-5" aria-labelledby="signin-heading">
  <div class="text-center mb-4">
    <i class="bi bi-person-circle display-5 text-primary" aria-hidden="true"></i>
    <h1 id="signin-heading" class="h2 fw-bold mt-2 mb-1">Chào mừng trở lại</h1>
    <p class="text-muted">Đăng nhập để tiếp tục khóa học của bạn.</p>
  </div>

  <form action="/account/signin" method="post" class="card" novalidate>
    <div class="card-body p-4 p-lg-5">
      {{#if disabled}}
      <div class="alert alert-danger" role="alert">Tài khoản đã bị vô hiệu hóa. Vui lòng liên hệ quản trị viên.</div>
      {{else if error}}
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        Tên đăng nhập hoặc mật khẩu không chính xác.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng thông báo"></button>
      </div>
      {{/if}}
      {{#if success}}
      <div class="alert alert-success alert-dismissible fade show" role="status">
        Tạo tài khoản thành công. Bạn có thể đăng nhập ngay.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng thông báo"></button>
      </div>
      {{/if}}

      <div class="mb-3">
        <label for="txtUsername" class="form-label fw-semibold">Tên đăng nhập</label>
        <input type="text" class="form-control" id="txtUsername" name="username" placeholder="Nhập tên đăng nhập"
          autocomplete="username" required autofocus>
        <div class="invalid-feedback">Vui lòng nhập tên đăng nhập.</div>
      </div>
      <div class="mb-4">
        <label for="txtPassword" class="form-label fw-semibold">Mật khẩu</label>
        <input type="password" class="form-control" id="txtPassword" name="password" placeholder="Nhập mật khẩu"
          autocomplete="current-password" required>
        <div class="invalid-feedback">Vui lòng nhập mật khẩu.</div>
      </div>
      <button type="submit" class="btn btn-primary w-100"><i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>Đăng nhập</button>
      <p class="text-center text-muted small mt-4 mb-0">Chưa có tài khoản? <a href="/account/signup" class="fw-semibold">Đăng ký miễn phí</a></p>
    </div>
  </form>
</section>

{{#fillContent "js"}}
<script>
  (() => {
    const form = document.querySelector('.auth-card form');
    form?.addEventListener('submit', event => {
      if (!form.checkValidity()) {
        event.preventDefault();
        event.stopPropagation();
      }
      form.classList.add('was-validated');
    });
  })();
</script>
{{/fillContent}}
