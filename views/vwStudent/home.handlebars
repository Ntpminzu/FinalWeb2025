<section class="py-4 py-lg-5" aria-labelledby="student-heading">
  <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4">
    <div>
      <p class="text-primary fw-semibold mb-1">Không gian học tập</p>
      <h1 id="student-heading" class="h2 fw-bold mb-1">Xin chào, {{user.name}}</h1>
      <p class="text-muted mb-0">Tiếp tục hành trình học tập của bạn tại Online Academy.</p>
    </div>
    <a href="/courses" class="btn btn-primary"><i class="bi bi-compass me-1" aria-hidden="true"></i>Khám phá khóa học</a>
  </div>

  <div class="row g-4">
    <div class="col-lg-5">
      <article class="card profile-card h-100">
        <div class="card-body p-lg-4">
          <div class="d-flex align-items-center gap-3 mb-4">
            <i class="bi bi-person-circle display-5 text-primary" aria-hidden="true"></i>
            <div><h2 class="h5 mb-1">Hồ sơ học viên</h2><span class="badge text-bg-light">{{user.permission}}</span></div>
          </div>
          <dl class="mb-4">
            <div class="info-item mb-3"><dt class="info-label">Họ và tên</dt><dd class="mb-0 fw-semibold">{{user.name}}</dd></div>
            <div class="info-item"><dt class="info-label">Email</dt><dd class="mb-0 text-break">{{user.email}}</dd></div>
          </dl>
          <a href="/student/profile?id={{user.id}}" class="btn btn-outline-primary w-100"><i class="bi bi-pencil-square me-1" aria-hidden="true"></i>Xem và chỉnh sửa hồ sơ</a>
        </div>
      </article>
    </div>

    <div class="col-lg-7">
      <div class="row g-3 h-100">
        <div class="col-sm-6">
          <a href="/student/courses" class="card h-100 text-decoration-none">
            <div class="card-body p-lg-4">
              <i class="bi bi-play-circle fs-2 text-primary" aria-hidden="true"></i>
              <h2 class="h5 mt-3">Khóa học của tôi</h2>
              <p class="text-muted mb-3">Xem tiến độ và tiếp tục bài học đang dang dở.</p>
              <span class="fw-semibold">Vào học <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
            </div>
          </a>
        </div>
        <div class="col-sm-6">
          <a href="/student/watchlist" class="card h-100 text-decoration-none">
            <div class="card-body p-lg-4">
              <i class="bi bi-heart fs-2 text-danger" aria-hidden="true"></i>
              <h2 class="h5 mt-3">Danh sách yêu thích</h2>
              <p class="text-muted mb-3">Lưu lại những khóa học bạn muốn khám phá sau.</p>
              <span class="fw-semibold">Xem danh sách <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
