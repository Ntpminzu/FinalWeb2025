<h2 class="text-center mt-4 mb-4">Quản lý Khóa học</h2>

<div class="container">
  <!-- Bộ lọc lĩnh vực + tìm kiếm -->
  <div class="row mb-3">
    <div class="col-md-4">
      <select class="form-select" id="categoryFilter">
        <option value="">Chọn lĩnh vực</option>
        {{#each categories}}
        <option value="{{this.name}}">{{this.name}}</option>
        {{/each}}
      </select>
    </div>

    <div class="col-md-4">
      <input type="text" id="searchInput" class="form-control" placeholder="Tìm theo tên khóa học hoặc giảng viên...">
    </div>
  </div>

  <table class="table table-striped table-bordered">
    <thead class="table-dark">
      <tr>
        <th>#</th>
        <th>Tên khóa học</th>
        <th>Lĩnh vực</th>
        <th>Giảng viên</th>
        <th>Hành động</th>
      </tr>
    </thead>
    <tbody id="courseTable">
      {{#each courses}}
      <tr>
        <td>{{@index}}</td>
        <td>{{this.course_title}}</td>
        <td>{{this.category_name}}</td>
        <td>{{this.instructor_name}}</td>
        <td>
          <form action="/admin/courses/delete/{{this.id}}" method="POST" style="display:inline;" 
                onsubmit="return confirm('Bạn có chắc muốn gỡ bỏ khóa học này?');">
            <button type="submit" class="btn btn-sm btn-danger">Gỡ bỏ</button>
          </form>
        </td>
      </tr>
      {{else}}
      <tr>
        <td colspan="5" class="text-center text-muted">Không có khóa học nào được tìm thấy.</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const categoryFilter = document.getElementById('categoryFilter');
  const searchInput = document.getElementById('searchInput');
  const rows = document.querySelectorAll('#courseTable tr');

  function filterTable() {
    const selectedCategory = categoryFilter.value.toLowerCase();
    const searchText = searchInput.value.toLowerCase();

    rows.forEach(row => {
      const courseName = row.cells[1]?.textContent.toLowerCase();
      const categoryName = row.cells[2]?.textContent.toLowerCase();
      const instructorName = row.cells[3]?.textContent.toLowerCase();

      const matchCategory = !selectedCategory || categoryName.includes(selectedCategory);
      const matchSearch = !searchText || courseName.includes(searchText) || instructorName.includes(searchText);

      row.style.display = matchCategory && matchSearch ? '' : 'none';
    });
  }

  categoryFilter.addEventListener('change', filterTable);
  searchInput.addEventListener('input', filterTable);
});
</script>
