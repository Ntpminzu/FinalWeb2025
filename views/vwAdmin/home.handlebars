<section class="py-4" aria-labelledby="admin-heading">
  <div class="hero-brand text-start p-4 p-lg-5 mb-5">
    <div class="position-relative" style="z-index:1">
      <p class="text-white-50 fw-semibold mb-1">Khu vực quản trị</p>
      <h1 id="admin-heading" class="h2 fw-bold text-white mb-2">Tổng quan hệ thống</h1>
      <p class="text-white-50 mb-0">Xin chào {{user.name}}. Theo dõi và quản lý Online Academy tại một nơi.</p>
    </div>
  </div>

  <h2 class="h4 fw-bold mb-3">Quản lý nhanh</h2>
  <div class="row g-3 mb-5">
    <div class="col-md-4"><a href="/admin/categories" class="card h-100 text-decoration-none"><div class="card-body d-flex align-items-center gap-3"><i class="bi bi-tags fs-2 text-primary" aria-hidden="true"></i><div><strong class="d-block text-dark">Lĩnh vực</strong><small class="text-muted">Tạo và sắp xếp danh mục</small></div></div></a></div>
    <div class="col-md-4"><a href="/admin/courses" class="card h-100 text-decoration-none"><div class="card-body d-flex align-items-center gap-3"><i class="bi bi-journal-richtext fs-2 text-primary" aria-hidden="true"></i><div><strong class="d-block text-dark">Khóa học</strong><small class="text-muted">Kiểm duyệt nội dung đào tạo</small></div></div></a></div>
    <div class="col-md-4"><a href="/admin/users" class="card h-100 text-decoration-none"><div class="card-body d-flex align-items-center gap-3"><i class="bi bi-people fs-2 text-primary" aria-hidden="true"></i><div><strong class="d-block text-dark">Người dùng</strong><small class="text-muted">Quản lý học viên và giảng viên</small></div></div></a></div>
  </div>

  <h2 class="h4 fw-bold mb-3">Thống kê tổng quan</h2>
  <div class="row g-3">
    <div class="col-sm-6 col-xl-3"><article class="card h-100"><div class="card-body"><div class="d-flex justify-content-between"><span class="text-muted fw-semibold">Khóa học</span><i class="bi bi-journals text-primary fs-4" aria-hidden="true"></i></div><div class="display-6 fw-bold my-2">{{stats.totalCourses}}</div><small class="text-muted">{{stats.publishedCourses}} đang hoạt động</small></div></article></div>
    <div class="col-sm-6 col-xl-3"><article class="card h-100"><div class="card-body"><div class="d-flex justify-content-between"><span class="text-muted fw-semibold">Học viên</span><i class="bi bi-mortarboard text-success fs-4" aria-hidden="true"></i></div><div class="display-6 fw-bold my-2">{{stats.totalStudents}}</div><small class="text-muted">{{stats.newStudentsThisMonth}} mới trong tháng</small></div></article></div>
    <div class="col-sm-6 col-xl-3"><article class="card h-100"><div class="card-body"><div class="d-flex justify-content-between"><span class="text-muted fw-semibold">Giảng viên</span><i class="bi bi-person-video3 text-warning fs-4" aria-hidden="true"></i></div><div class="display-6 fw-bold my-2">{{stats.totalInstructors}}</div><small class="text-muted">{{stats.newInstructors}} giảng viên mới</small></div></article></div>
    <div class="col-sm-6 col-xl-3"><article class="card h-100"><div class="card-body"><div class="d-flex justify-content-between"><span class="text-muted fw-semibold">Lĩnh vực</span><i class="bi bi-grid text-info fs-4" aria-hidden="true"></i></div><div class="display-6 fw-bold my-2">{{stats.totalCategories}}</div><small class="text-muted">Đã được phân loại</small></div></article></div>
  </div>
</section>
