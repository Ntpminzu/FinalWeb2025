<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Online Academy - nền tảng học trực tuyến với các khóa học chất lượng từ những giảng viên giàu kinh nghiệm.">
  <meta name="theme-color" content="#2563eb">
  <meta name="csrf-token" content="{{csrfToken}}">
  <title>{{#if pageTitle}}{{pageTitle}} | {{/if}}Online Academy</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;500;600;700;800&family=Rubik:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/static/style.css">
  {{{_sections.css}}}
</head>

<body class="theme-blue d-flex flex-column min-vh-100">
  <a class="skip-link" href="#main-content">Bỏ qua điều hướng</a>

  <header class="site-header sticky-top">
    <nav class="navbar navbar-expand-lg" aria-label="Điều hướng chính">
      <div class="container-xl">
        <a class="navbar-brand d-flex align-items-center gap-2" href="/" aria-label="Online Academy - Trang chủ">
          <img src="/static/imgs/logo.png" alt="" width="42" height="42">
          <span class="brand-name">Online Academy</span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
          aria-controls="mainNavbar" aria-expanded="false" aria-label="Mở menu điều hướng">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">
          <ul class="navbar-nav ms-lg-3">
            <li class="nav-item dropdown">
              <button class="nav-link dropdown-toggle" id="navbarDropdownCategories" type="button"
                data-bs-toggle="dropdown" aria-expanded="false">
                Khám phá
              </button>
              <ul class="dropdown-menu" aria-labelledby="navbarDropdownCategories">
                {{#each categories}}
                <li><a class="dropdown-item fw-semibold" href="/categories/{{this.id}}">{{this.catname}}</a></li>
                {{#if this.children}}
                  {{#each this.children}}
                  <li><a class="dropdown-item ps-lg-4" href="/categories/{{this.id}}"><span aria-hidden="true">↳</span> {{this.catname}}</a></li>
                  {{/each}}
                {{/if}}
                {{/each}}
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="/courses"><i class="bi bi-grid me-2" aria-hidden="true"></i>Tất cả khóa học</a></li>
              </ul>
            </li>
          </ul>

          <form class="navbar-search mx-lg-3 my-3 my-lg-0" role="search" action="/search" method="get">
            <label class="visually-hidden" for="site-search">Tìm kiếm khóa học</label>
            <div class="input-group">
              <span class="input-group-text" aria-hidden="true"><i class="bi bi-search"></i></span>
              <input class="form-control" id="site-search" type="search" name="q"
                placeholder="Bạn muốn học gì hôm nay?" autocomplete="off">
              <button class="btn btn-primary" type="submit">Tìm kiếm</button>
            </div>
          </form>

          <div class="navbar-actions d-flex align-items-center gap-2 ms-lg-auto">
            <a href="/cart" class="cart-link btn btn-light position-relative" aria-label="Giỏ hàng{{#if cartTotal}}, có {{cartTotal}} khóa học{{/if}}">
              <i class="bi bi-cart3 fs-5" aria-hidden="true"></i><span class="d-lg-none ms-2">Giỏ hàng</span>
              {{#if cartTotal}}
              <span class="cart-badge badge rounded-pill bg-danger">{{cartTotal}}<span class="visually-hidden"> khóa học</span></span>
              {{/if}}
            </a>

            {{#if isAuthenticated}}
            <div class="nav-item dropdown flex-grow-1 flex-lg-grow-0">
              <button class="user-menu btn btn-light dropdown-toggle w-100" type="button" id="navbarDropdownUser"
                data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle me-1" aria-hidden="true"></i>{{authUser.name}}
              </button>
              <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdownUser">
                <li><a class="dropdown-item" href="/{{authUser.role}}/profile"><i class="bi bi-person me-2" aria-hidden="true"></i>Hồ sơ của tôi</a></li>
                {{#if (eq authUser.role "instructor")}}
                <li><a class="dropdown-item" href="/instructor/dashboard"><i class="bi bi-journal-text me-2" aria-hidden="true"></i>Khóa học của tôi</a></li>
                {{else if (eq authUser.role "student")}}
                <li><a class="dropdown-item" href="/student/courses"><i class="bi bi-journal-text me-2" aria-hidden="true"></i>Khóa học của tôi</a></li>
                <li><a class="dropdown-item" href="/student/watchlist"><i class="bi bi-heart me-2" aria-hidden="true"></i>Danh sách yêu thích</a></li>
                {{/if}}
                <li><hr class="dropdown-divider"></li>
                <li>
                  <form action="/account/signout" method="post" class="m-0">
                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Đăng xuất</button>
                  </form>
                </li>
              </ul>
            </div>
            {{else}}
            <a class="btn btn-outline-primary" href="/account/signin">Đăng nhập</a>
            <a class="btn btn-primary" href="/account/signup">Đăng ký</a>
            {{/if}}
          </div>
        </div>
      </div>
    </nav>
  </header>

  <main id="main-content" class="site-main container-xl flex-grow-1" tabindex="-1">
    {{{body}}}
  </main>

  <footer class="site-footer mt-auto">
    <div class="container-xl d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
      <div class="d-flex align-items-center gap-2">
        <img src="/static/imgs/logo.png" alt="" width="34" height="34">
        <div><strong>Online Academy</strong><small class="d-block">Học mỗi ngày, tiến xa hơn.</small></div>
      </div>
      <nav class="footer-links" aria-label="Liên kết cuối trang">
        <a href="/courses">Khóa học</a>
        <a href="/account/signup">Bắt đầu học</a>
        <a href="/">Trang chủ</a>
      </nav>
      <small>© {{currentYear}} Online Academy</small>
    </div>
  </footer>

  <script>
    (() => {
      const token = document.querySelector('meta[name="csrf-token"]')?.content;
      if (!token) return;
      document.querySelectorAll('form').forEach(form => {
        const method = (form.getAttribute('method') || 'get').toLowerCase();
        if (method === 'get' || form.querySelector('input[name="_csrf"]')) return;
        if ((form.enctype || '').toLowerCase() === 'multipart/form-data') {
          const action = new URL(form.action, window.location.origin);
          action.searchParams.set('_csrf', token);
          form.action = action.pathname + action.search;
        }
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = '_csrf';
        input.value = token;
        form.appendChild(input);
      });
    })();
  </script>
  {{{_sections.js}}}
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
