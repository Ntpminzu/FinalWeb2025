<mxfile host="app.diagrams.net">
  <diagram name="UC04 - Search Course" id="uc04_seq">
    <mxGraphModel dx="1422" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="950" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ==================== TITLE ==================== -->
        <mxCell id="title" value="&lt;b&gt;Sequence Diagram: UC04 - Search Course (Tìm kiếm khóa học) [Layered Architecture]&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="220" y="5" width="550" height="30" as="geometry"/>
        </mxCell>

        <!-- ==================== LIFELINES ==================== -->

        <!-- Guest (Actor) -->
        <mxCell id="guest" value="Guest" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="100" height="540" as="geometry"/>
        </mxCell>

        <!-- SearchView (Boundary) -->
        <mxCell id="view" value="&lt;b&gt;SearchView&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="200" y="40" width="120" height="540" as="geometry"/>
        </mxCell>

        <!-- SearchAPI (Controller) -->
        <mxCell id="api" value="&lt;b&gt;SearchAPI&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="350" y="40" width="130" height="540" as="geometry"/>
        </mxCell>

        <!-- CourseService (Service) -->
        <mxCell id="courseService" value="&lt;b&gt;CourseService&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="510" y="40" width="140" height="540" as="geometry"/>
        </mxCell>

        <!-- CourseDAO (DAO) -->
        <mxCell id="courseDAO" value="&lt;b&gt;CourseDAO&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="680" y="40" width="110" height="540" as="geometry"/>
        </mxCell>

        <!-- Database (Entity/DBMS) -->
        <mxCell id="db" value="&lt;b&gt;Database&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="830" y="40" width="100" height="540" as="geometry"/>
        </mxCell>

        <!-- ==================== FLOW MESSAGES ==================== -->

        <!-- 1. Guest -> SearchView: enter keyword & search -->
        <mxCell id="msg1" value="enter keyword and submit search" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="110" y="110" as="sourcePoint"/>
            <mxPoint x="260" y="110" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 2. SearchView -> SearchAPI: searchCourses(keyword, page) -->
        <mxCell id="msg2" value="searchCourses(keyword, page)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="260" y="140" as="sourcePoint"/>
            <mxPoint x="415" y="140" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 3. SearchAPI -> CourseService: searchCourses(keyword, page) -->
        <mxCell id="msg3" value="searchCourses(keyword, page)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="415" y="170" as="sourcePoint"/>
            <mxPoint x="580" y="170" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 4. CourseService -> CourseDAO: search(keyword, page) -->
        <mxCell id="msg4" value="search(keyword, page)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="200" as="sourcePoint"/>
            <mxPoint x="735" y="200" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 5. CourseDAO -> Database: execute query -->
        <mxCell id="msg5" value="execute full-text query" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="735" y="225" as="sourcePoint"/>
            <mxPoint x="880" y="225" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 6. Database -> CourseDAO: return matching list + total count -->
        <mxCell id="msg6" value="return matching list + total count" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="880" y="255" as="sourcePoint"/>
            <mxPoint x="735" y="255" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 7. CourseDAO -> CourseService: return list + total count -->
        <mxCell id="msg7" value="return list + total count" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="735" y="280" as="sourcePoint"/>
            <mxPoint x="580" y="280" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 8. CourseService -> SearchAPI: return search results -->
        <mxCell id="msg8" value="return search results" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="305" as="sourcePoint"/>
            <mxPoint x="415" y="305" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ALT Frame [search results] -->
        <mxCell id="alt_search_results" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=40;height=20;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=5;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="45" y="330" width="890" height="210" as="geometry"/>
        </mxCell>

        <!-- Guard [no matching courses found (Exception 3.1)] -->
        <mxCell id="guard_no_results" value="[no results found (Exception 3.1)]" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=3;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="340" width="180" height="25" as="geometry"/>
        </mxCell>

        <!-- 9. SearchAPI -> SearchView: return empty results -->
        <mxCell id="msg9" value="return empty results" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="415" y="375" as="sourcePoint"/>
            <mxPoint x="260" y="375" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 10. SearchView -> Guest: show "Không tìm thấy..." -->
        <mxCell id="msg10" value="show message &quot;Không tìm thấy khóa học phù hợp&quot;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="260" y="405" as="sourcePoint"/>
            <mxPoint x="110" y="405" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Separator -->
        <mxCell id="sep_results" value="" style="endArrow=none;dashed=1;html=1;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="45" y="430" as="sourcePoint"/>
            <mxPoint x="935" y="430" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Guard [matching courses found] -->
        <mxCell id="guard_results_found" value="[results found]" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=3;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="440" width="90" height="25" as="geometry"/>
        </mxCell>

        <!-- 11. SearchAPI -> SearchView: return matching courses with pagination -->
        <mxCell id="msg11" value="return results with pagination info" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="415" y="475" as="sourcePoint"/>
            <mxPoint x="260" y="475" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 12. SearchView -> Guest: render list + pagination -->
        <mxCell id="msg12" value="display course list and pagination options" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="260" y="505" as="sourcePoint"/>
            <mxPoint x="110" y="505" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
