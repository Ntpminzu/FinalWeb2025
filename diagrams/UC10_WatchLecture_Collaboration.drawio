<mxfile host="app.diagrams.net">
  <diagram name="UC10 - Watch Lecture (Collaboration)" id="uc10_collab">
    <mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ==================== TITLE ==================== -->
        <mxCell id="title" value="&lt;b&gt;Collaboration Diagram: UC10 - Watch Lecture (Xem bài giảng) [Simple BCE]&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="325" y="10" width="500" height="30" as="geometry"/>
        </mxCell>

        <!-- ==================== OBJECTS / NODES ==================== -->

        <!-- Student (Actor) -->
        <mxCell id="student" value="Student" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="220" width="40" height="80" as="geometry"/>
        </mxCell>

        <!-- :LectureBoundary (Boundary) -->
        <mxCell id="boundary" value="&amp;#171;boundary&amp;#187;&lt;br&gt;&lt;b&gt;:LectureBoundary&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="220" y="230" width="130" height="60" as="geometry"/>
        </mxCell>

        <!-- :LectureController (Control) -->
        <mxCell id="control" value="&amp;#171;control&amp;#187;&lt;br&gt;&lt;b&gt;:LectureController&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="450" y="230" width="140" height="60" as="geometry"/>
        </mxCell>

        <!-- :LectureDAO (Entity/DAO) -->
        <mxCell id="lectureDAO" value="&amp;#171;entity&amp;#187;&lt;br&gt;&lt;b&gt;:LectureDAO&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="690" y="110" width="140" height="60" as="geometry"/>
        </mxCell>

        <!-- :LectureProgressDAO (Entity/DAO) -->
        <mxCell id="progressDAO" value="&amp;#171;entity&amp;#187;&lt;br&gt;&lt;b&gt;:LectureProgressDAO&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="690" y="350" width="150" height="60" as="geometry"/>
        </mxCell>

        <!-- Database (DBMS) -->
        <mxCell id="db" value="&amp;#171;database&amp;#187;&lt;br&gt;&lt;b&gt;Database&lt;/b&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="930" y="225" width="90" height="70" as="geometry"/>
        </mxCell>

        <!-- ==================== LINKS ==================== -->

        <!-- Student - Boundary -->
        <mxCell id="link1" style="endArrow=none;html=1;rounded=0;strokeWidth=1.5;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="student" target="boundary">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Boundary - Control -->
        <mxCell id="link2" style="endArrow=none;html=1;rounded=0;strokeWidth=1.5;" edge="1" parent="1" source="boundary" target="control">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Control - LectureDAO -->
        <mxCell id="link3" style="endArrow=none;html=1;rounded=0;strokeWidth=1.5;" edge="1" parent="1" source="control" target="lectureDAO">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Control - ProgressDAO -->
        <mxCell id="link4" style="endArrow=none;html=1;rounded=0;strokeWidth=1.5;" edge="1" parent="1" source="control" target="progressDAO">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- LectureDAO - Database -->
        <mxCell id="link5" style="endArrow=none;html=1;rounded=0;strokeWidth=1.5;" edge="1" parent="1" source="lectureDAO" target="db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ProgressDAO - Database -->
        <mxCell id="link6" style="endArrow=none;html=1;rounded=0;strokeWidth=1.5;" edge="1" parent="1" source="progressDAO" target="db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ==================== MESSAGES ON LINKS ==================== -->

        <!-- Messages: Student - Boundary -->
        <mxCell id="msgLink1_forward" value="1: select a lecture in outline list &amp;#8594;&lt;br&gt;2: finishes watching / clicks &quot;Đánh dấu hoàn thành&quot; &amp;#8594;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="110" y="180" width="220" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="msgLink1_backward" value="&amp;#8592; 1.1.2.1: show warning (no lectures)&lt;br&gt;&amp;#8592; 1.1.5.1: play video &amp; resources&lt;br&gt;&amp;#8592; 2.1.2.1: update status to &quot;Đã hoàn thành&quot;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="110" y="300" width="210" height="40" as="geometry"/>
        </mxCell>

        <!-- Messages: Boundary - Control -->
        <mxCell id="msgLink2_forward" value="1.1: getLecture(userId, courseId, lectureId) &amp;#8594;&lt;br&gt;2.1: saveProgress(userId, lectureId, last_second, duration_sec) &amp;#8594;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="300" y="180" width="280" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="msgLink2_backward" value="&amp;#8592; 1.1.2: return error (no lectures)&lt;br&gt;&amp;#8592; 1.1.5: renderLearnPage(lectureData, progress)&lt;br&gt;&amp;#8592; 2.1.2: updateStatusIcon()" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="310" y="300" width="250" height="40" as="geometry"/>
        </mxCell>

        <!-- Messages: Control - LectureDAO -->
        <mxCell id="msgLink3_forward" value="1.1.1: findByCourse(courseId) &amp;#8599;&lt;br&gt;1.1.3: findById(lectureId) &amp;#8599;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="490" y="140" width="160" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="msgLink3_backward" value="&amp;#8601; 1.1.1.2: return lectures list&lt;br&gt;&amp;#8601; 1.1.3.3: return lecture details" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="580" y="195" width="150" height="30" as="geometry"/>
        </mxCell>

        <!-- Messages: Control - ProgressDAO -->
        <mxCell id="msgLink4_forward" value="1.1.4: find(userId, lectureId) &amp;#8600;&lt;br&gt;2.1.1: upsert(userId, lectureId, progress) &amp;#8600;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="460" y="320" width="200" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="msgLink4_backward" value="&amp;#8598; 1.1.4.3: return progress details&lt;br&gt;&amp;#8598; 2.1.1.3: return success (ok: true)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="540" y="300" width="170" height="30" as="geometry"/>
        </mxCell>

        <!-- Messages: LectureDAO - Database -->
        <mxCell id="msgLink5_forward" value="1.1.1.1: execute select query &amp;#8600;&lt;br&gt;1.1.3.1: execute select query &amp;#8600;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="800" y="150" width="160" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="msgLink5_backward" value="&amp;#8598; 1.1.1.1.1: return lectures rows&lt;br&gt;&amp;#8598; 1.1.3.2: return video URL &amp; metadata rows" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="770" y="200" width="210" height="30" as="geometry"/>
        </mxCell>

        <!-- Messages: ProgressDAO - Database -->
        <mxCell id="msgLink6_forward" value="1.1.4.1: execute select query &amp;#8599;&lt;br&gt;2.1.1.1: execute upsert query &amp;#8599;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="810" y="330" width="160" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="msgLink6_backward" value="&amp;#8601; 1.1.4.2: return progress row&lt;br&gt;&amp;#8601; 2.1.1.2: return success" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="800" y="295" width="160" height="30" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
