        <!-- 10. CourseAPI -> CourseDetailView: return 404 -->
        <mxCell id="msg10" value="return 404 page" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="415" as="sourcePoint"/>
            <mxPoint x="295" y="415" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 11. CourseDetailView -> Actor: show 404 page -->
        <mxCell id="msg11" value="show error &quot;Khóa học không tồn tại hoặc không khả dụng&quot; (Lỗi 404)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
