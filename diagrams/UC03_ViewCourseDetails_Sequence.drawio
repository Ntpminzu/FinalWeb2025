        <!-- Guard [course hidden/deleted (Exception 1.1)] -->
        <mxCell id="guard_unavailable" value="[hidden or deleted (Exception 1.1)]" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=3;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="360" width="180" height="25" as="geometry"/>
        </mxCell>

        <!-- 9. CourseService -> CourseAPI: return error -->
