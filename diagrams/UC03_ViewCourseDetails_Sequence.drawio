        <!-- 5. CourseDAO -> Database: execute query -->
        <mxCell id="msg5" value="execute query" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="795" y="225" as="sourcePoint"/>
