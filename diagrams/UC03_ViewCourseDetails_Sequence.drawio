<mxfile host="app.diagrams.net">
  <diagram name="UC03 - View Course Details" id="uc03_seq">
    <mxGraphModel dx="1422" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ==================== TITLE ==================== -->
        <mxCell id="title" value="&lt;b&gt;Sequence Diagram: UC03 - View Course Details (Xem chi tiết khóa học) [Layered Architecture]&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="250" y="5" width="600" height="30" as="geometry"/>
        </mxCell>

        <!-- ==================== LIFELINES ==================== -->

        <!-- Guest/Instructor (Actor) -->
        <mxCell id="actor" value="Guest / Instructor" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="130" height="880" as="geometry"/>
        </mxCell>

        <!-- CourseDetailView (Boundary) -->
        <mxCell id="view" value="&lt;b&gt;CourseDetailView&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="230" y="40" width="130" height="880" as="geometry"/>
        </mxCell>

        <!-- CourseAPI (Controller) -->
        <mxCell id="api" value="&lt;b&gt;CourseAPI&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="400" y="40" width="120" height="880" as="geometry"/>
        </mxCell>

        <!-- CourseService (Service) -->
        <mxCell id="courseService" value="&lt;b&gt;CourseService&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="560" y="40" width="140" height="880" as="geometry"/>
        </mxCell>

        <!-- CourseDAO (DAO) -->
        <mxCell id="courseDAO" value="&lt;b&gt;CourseDAO&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="740" y="40" width="110" height="880" as="geometry"/>
        </mxCell>

        <!-- Database (Entity/DBMS) -->
        <mxCell id="db" value="&lt;b&gt;Database&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="900" y="40" width="100" height="880" as="geometry"/>
        </mxCell>

        <!-- ==================== FLOW MESSAGES ==================== -->

        <!-- 1. Actor -> CourseDetailView: Click on a course -->
        <mxCell id="msg1" value="click on a course" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="125" y="110" as="sourcePoint"/>
            <mxPoint x="295" y="110" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 2. CourseDetailView -> CourseAPI: getCourseDetails(courseId) -->
        <mxCell id="msg2" value="getCourseDetails(courseId)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="295" y="140" as="sourcePoint"/>
            <mxPoint x="460" y="140" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 3. CourseAPI -> CourseService: getCourseDetails(courseId) -->
        <mxCell id="msg3" value="getCourseDetails(courseId)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="170" as="sourcePoint"/>
            <mxPoint x="630" y="170" as="targetPoint"/>
