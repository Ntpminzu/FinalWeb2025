<mxfile host="app.diagrams.net">
  <diagram name="UC01 - Register (Simple BCE)" id="uc01_simple_bce_seq">
    <mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ==================== TITLE ==================== -->
        <mxCell id="title" value="&lt;b&gt;Sequence Diagram: UC01 - Register (Đăng ký) [Simple BCE with DAO &amp; DB]&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="300" y="5" width="500" height="30" as="geometry"/>
        </mxCell>

        <!-- ==================== LIFELINES ==================== -->

        <!-- Guest (Actor) -->
        <mxCell id="guest" value="Guest" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="100" height="660" as="geometry"/>
        </mxCell>

        <!-- :RegisterBoundary (Boundary) -->
        <mxCell id="boundary" value="&lt;b&gt;:RegisterBoundary&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="200" y="40" width="130" height="660" as="geometry"/>
        </mxCell>

        <!-- :AccountController (Control) -->
        <mxCell id="control" value="&lt;b&gt;:AccountController&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="370" y="40" width="140" height="660" as="geometry"/>
        </mxCell>

        <!-- :UserDAO (Entity/DAO) -->
        <mxCell id="userDAO" value="&lt;b&gt;:UserDAO&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="550" y="40" width="110" height="660" as="geometry"/>
        </mxCell>

        <!-- :OtpTokenDAO (Entity/DAO) -->
        <mxCell id="otpTokenDAO" value="&lt;b&gt;:OtpTokenDAO&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="690" y="40" width="130" height="660" as="geometry"/>
        </mxCell>

        <!-- Database (DBMS) -->
        <mxCell id="db" value="&lt;b&gt;Database&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="850" y="40" width="100" height="660" as="geometry"/>
        </mxCell>

        <!-- EmailSystem (External System) -->
        <mxCell id="emailSystem" value="&lt;b&gt;EmailSystem&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="980" y="40" width="120" height="660" as="geometry"/>
        </mxCell>

        <!-- ==================== FLOW MESSAGES ==================== -->

        <!-- 1. Guest -> :RegisterBoundary: enter register information -->
        <mxCell id="msg1" value="enter register information (name, email, password, dob)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="110" y="110" as="sourcePoint"/>
            <mxPoint x="265" y="110" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 2. :RegisterBoundary -> :AccountController: doSignup(...) -->
        <mxCell id="msg2" value="doSignup(username, password, email, name, dob)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="265" y="140" as="sourcePoint"/>
            <mxPoint x="440" y="140" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 3. :AccountController -> :UserDAO: findByEmail(email) -->
        <mxCell id="msg3" value="findByEmail(email)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="440" y="170" as="sourcePoint"/>
            <mxPoint x="605" y="170" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 3_db. :UserDAO -> Database: execute select query -->
        <mxCell id="msg3_db" value="execute select query" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="605" y="195" as="sourcePoint"/>
            <mxPoint x="900" y="195" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 3_db_ret. Database -> :UserDAO: return user row -->
        <mxCell id="msg3_db_ret" value="return user row" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="900" y="220" as="sourcePoint"/>
            <mxPoint x="605" y="220" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 4. :UserDAO -> :AccountController: return existsEmail -->
        <mxCell id="msg4" value="return existsEmail" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="605" y="245" as="sourcePoint"/>
            <mxPoint x="440" y="245" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ALT Frame [email availability] -->
        <mxCell id="alt_email" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=40;height=20;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=5;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="45" y="270" width="1075" height="390" as="geometry"/>
        </mxCell>

        <!-- Guard [email exists] -->
        <mxCell id="guard_exists" value="[email exists]" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=3;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="280" width="100" height="25" as="geometry"/>
        </mxCell>

        <!-- 5_err. :AccountController -> :RegisterBoundary: renderSignup(emailExist: true) -->
        <mxCell id="msg5_err" value="renderSignup(emailExist: true)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="440" y="305" as="sourcePoint"/>
            <mxPoint x="265" y="305" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 6_err. :RegisterBoundary -> Guest: show error -->
        <mxCell id="msg6_err" value="show message &quot;Email đã tồn tại&quot;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="265" y="330" as="sourcePoint"/>
            <mxPoint x="110" y="330" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Separator -->
        <mxCell id="sep_email" value="" style="endArrow=none;dashed=1;html=1;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="45" y="360" as="sourcePoint"/>
            <mxPoint x="1120" y="360" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Guard [email does not exist] -->
        <mxCell id="guard_not_exists" value="[email does not exist]" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=3;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="370" width="140" height="25" as="geometry"/>
        </mxCell>

        <!-- 7. :AccountController -> :AccountController: generateOtp() -->
        <mxCell id="msg7" value="generateOtp()" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="440" y="395" as="sourcePoint"/>
            <mxPoint x="440" y="425" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="490" y="395"/>
              <mxPoint x="490" y="425"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 8. :AccountController -> :OtpTokenDAO: insert(email, otp, expires_at) -->
        <mxCell id="msg8" value="insert(email, otp, expires_at)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="440" y="450" as="sourcePoint"/>
            <mxPoint x="755" y="450" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 8_db. :OtpTokenDAO -> Database: execute insert query -->
        <mxCell id="msg8_db" value="execute insert query" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="755" y="475" as="sourcePoint"/>
            <mxPoint x="900" y="475" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 8_db_ret. Database -> :OtpTokenDAO: return success -->
        <mxCell id="msg8_db_ret" value="return success" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="900" y="500" as="sourcePoint"/>
            <mxPoint x="755" y="500" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 9. :OtpTokenDAO -> :AccountController: return success -->
        <mxCell id="msg9" value="return success" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="755" y="525" as="sourcePoint"/>
            <mxPoint x="440" y="525" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 10. :AccountController -> EmailSystem: sendMail(email, otp) -->
        <mxCell id="msg10" value="sendMail(email, otp)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="440" y="555" as="sourcePoint"/>
            <mxPoint x="1040" y="555" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 11. EmailSystem -> :AccountController: return success -->
        <mxCell id="msg11" value="return success" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1040" y="580" as="sourcePoint"/>
            <mxPoint x="440" y="580" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 12. :AccountController -> :RegisterBoundary: renderVerifyOtp(userData) -->
        <mxCell id="msg12" value="renderVerifyOtp(hiddenData)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="440" y="610" as="sourcePoint"/>
            <mxPoint x="265" y="610" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 13. :RegisterBoundary -> Guest: display OTP verification page -->
        <mxCell id="msg13" value="display OTP verification page and redirect" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="265" y="635" as="sourcePoint"/>
            <mxPoint x="110" y="635" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
