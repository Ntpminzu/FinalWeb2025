          <mxGeometry x="200" y="40" width="120" height="990" as="geometry"/>
        </mxCell>

        <!-- ReviewAPI (Controller) -->
        <mxCell id="api" value="&lt;b&gt;ReviewAPI&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
