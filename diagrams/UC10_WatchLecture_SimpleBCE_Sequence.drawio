            <mxPoint x="45" y="365" as="sourcePoint"/>
            <mxPoint x="985" y="365" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Guard [lectures exist] -->
        <mxCell id="guard_lectures_exist" value="[lectures exist]" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=3;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="375" width="100" height="25" as="geometry"/>
        </mxCell>

        <!-- 9. :LectureController -> :LectureDAO: findById(lectureId) -->
        <mxCell id="msg9" value="findById(lectureId)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
