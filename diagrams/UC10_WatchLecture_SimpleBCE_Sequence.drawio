          </mxGeometry>
        </mxCell>

        <!-- 5. Database -> :LectureDAO: return lectures rows -->
        <mxCell id="msg5" value="return lectures rows" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="930" y="220" as="sourcePoint"/>
