        <!-- 17. :LectureController -> :LectureBoundary: renderLearnPage(lectureData, progress) -->
        <mxCell id="msg17" value="renderLearnPage(lectureData, progress)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
