        </mxCell>

        <!-- 8. :LectureBoundary -> Student: show warning -->
        <mxCell id="msg8_err" value="show message &quot;Khóa học chưa có bài giảng.&quot; and &quot;Quay lại&quot; button" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="265" y="335" as="sourcePoint"/>
            <mxPoint x="110" y="335" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Separator -->
        <mxCell id="sep_lecture" value="" style="endArrow=none;dashed=1;html=1;strokeWidth=1;" edge="1" parent="1">
