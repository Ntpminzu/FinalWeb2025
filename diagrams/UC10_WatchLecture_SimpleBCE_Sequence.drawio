<mxfile host="app.diagrams.net">
  <diagram name="UC10 - Watch Lecture (Simple BCE)" id="uc10_simple_bce_seq">
    <mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ==================== TITLE ==================== -->
        <mxCell id="title" value="&lt;b&gt;Sequence Diagram: UC10 - Watch Lecture (Xem bài giảng) [Simple BCE with DAO &amp; DB]&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="250" y="5" width="550" height="30" as="geometry"/>
        </mxCell>

        <!-- ==================== LIFELINES ==================== -->

        <!-- Student (Actor) -->
        <mxCell id="student" value="Student" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="100" height="880" as="geometry"/>
        </mxCell>

        <!-- :LectureBoundary (Boundary) -->
        <mxCell id="boundary" value="&lt;b&gt;:LectureBoundary&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="200" y="40" width="130" height="880" as="geometry"/>
        </mxCell>

        <!-- :LectureController (Control) -->
        <mxCell id="control" value="&lt;b&gt;:LectureController&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="370" y="40" width="140" height="880" as="geometry"/>
        </mxCell>

        <!-- :LectureDAO (Entity/DAO) -->
        <mxCell id="lectureDAO" value="&lt;b&gt;:LectureDAO&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="550" y="40" width="110" height="880" as="geometry"/>
        </mxCell>

        <!-- :LectureProgressDAO (Entity/DAO) -->
        <mxCell id="lectureProgressDAO" value="&lt;b&gt;:LectureProgressDAO&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="700" y="40" width="140" height="880" as="geometry"/>
        </mxCell>

        <!-- Database (DBMS) -->
        <mxCell id="db" value="&lt;b&gt;Database&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="880" y="40" width="100" height="880" as="geometry"/>
        </mxCell>

        <!-- ==================== FLOW MESSAGES ==================== -->

        <!-- 1. Student -> :LectureBoundary: select lecture -->
        <mxCell id="msg1" value="select a lecture in outline list" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="110" y="110" as="sourcePoint"/>
            <mxPoint x="265" y="110" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 2. :LectureBoundary -> :LectureController: getLecture(userId, courseId, lectureId) -->
        <mxCell id="msg2" value="getLecture(userId, courseId, lectureId)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;endFill=1;" edge="1" parent="1">
