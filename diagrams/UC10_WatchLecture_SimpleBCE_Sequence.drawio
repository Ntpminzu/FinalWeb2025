            <mxPoint x="440" y="610" as="sourcePoint"/>
            <mxPoint x="265" y="610" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 18. :LectureBoundary -> Student: play video & show resources -->
        <mxCell id="msg18" value="play video lecture and display resources" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
