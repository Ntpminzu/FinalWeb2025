<mxfile host="app.diagrams.net">
  <diagram name="UC09 - View Purchased Courses (Simple BCE)" id="uc09_simple_bce_seq">
    <mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ==================== TITLE ==================== -->
        <mxCell id="title" value="&lt;b&gt;Sequence Diagram: UC09 - View Purchased Courses (Xem khóa học đã mua) [Simple BCE with DAO &amp; DB]&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="200" y="5" width="600" height="30" as="geometry"/>
        </mxCell>

        <!-- ==================== LIFELINES ==================== -->

        <!-- Student (Actor) -->
        <mxCell id="student" value="Student" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="100" height="680" as="geometry"/>
        </mxCell>

        <!-- :MyCoursesBoundary (Boundary) -->
        <mxCell id="boundary" value="&lt;b&gt;:MyCoursesBoundary&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="200" y="40" width="130" height="680" as="geometry"/>
        </mxCell>

        <!-- :CourseController (Control) -->
        <mxCell id="control" value="&lt;b&gt;:CourseController&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="370" y="40" width="140" height="680" as="geometry"/>
        </mxCell>

        <!-- :PurchasedDAO (Entity/DAO) -->
        <mxCell id="purchasedDAO" value="&lt;b&gt;:PurchasedDAO&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="550" y="40" width="110" height="680" as="geometry"/>
        </mxCell>

        <!-- :LectureProgressDAO (Entity/DAO) -->
        <mxCell id="lectureProgressDAO" value="&lt;b&gt;:LectureProgressDAO&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="690" y="40" width="140" height="680" as="geometry"/>
        </mxCell>

        <!-- Database (DBMS) -->
        <mxCell id="db" value="&lt;b&gt;Database&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="860" y="40" width="100" height="680" as="geometry"/>
        </mxCell>

        <!-- ==================== FLOW MESSAGES ==================== -->

        <!-- 1. Student -> :MyCoursesBoundary: Click My Courses -->
        <mxCell id="msg1" value="click &quot;My Courses&quot; in profile dropdown" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="110" y="110" as="sourcePoint"/>
            <mxPoint x="265" y="110" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 2. :MyCoursesBoundary -> :CourseController: getPurchasedCourses(userId) -->
        <mxCell id="msg2" value="getPurchasedCourses(userId)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="265" y="140" as="sourcePoint"/>
            <mxPoint x="440" y="140" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 3. :CourseController -> :PurchasedDAO: listByUser(userId) -->
        <mxCell id="msg3" value="listByUser(userId)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="440" y="170" as="sourcePoint"/>
            <mxPoint x="605" y="170" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 4. :PurchasedDAO -> Database: execute select query -->
        <mxCell id="msg4" value="execute select query" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="605" y="195" as="sourcePoint"/>
            <mxPoint x="910" y="195" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 5. Database -> :PurchasedDAO: return purchased courses rows -->
        <mxCell id="msg5" value="return purchased courses rows" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="910" y="220" as="sourcePoint"/>
            <mxPoint x="605" y="220" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 6. :PurchasedDAO -> :CourseController: return purchased list -->
        <mxCell id="msg6" value="return purchased list" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="605" y="245" as="sourcePoint"/>
            <mxPoint x="440" y="245" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ALT Frame [purchased courses count check] -->
        <mxCell id="alt_purchased" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=40;height=20;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=5;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="45" y="270" width="940" height="400" as="geometry"/>
        </mxCell>

        <!-- Guard [empty list (Exception 2.1)] -->
        <mxCell id="guard_empty" value="[purchased list is empty (Exception 2.1)]" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=3;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="280" width="220" height="25" as="geometry"/>
        </mxCell>

        <!-- 7. :CourseController -> :MyCoursesBoundary: return empty list -->
        <mxCell id="msg7_empty" value="return empty list" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="440" y="305" as="sourcePoint"/>
            <mxPoint x="265" y="305" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 8. :MyCoursesBoundary -> Student: show warning -->
        <mxCell id="msg8_empty" value="show &quot;Bạn chưa sở hữu khóa học nào&quot; and &quot;Khám phá khóa học ngay&quot; button" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="265" y="330" as="sourcePoint"/>
            <mxPoint x="110" y="330" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Separator -->
        <mxCell id="sep_purchased" value="" style="endArrow=none;dashed=1;html=1;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="45" y="365" as="sourcePoint"/>
            <mxPoint x="985" y="365" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Guard [has purchased courses] -->
        <mxCell id="guard_has_courses" value="[purchased list has courses]" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=3;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="375" width="160" height="25" as="geometry"/>
        </mxCell>

        <!-- LOOP Frame [for each course] -->
        <mxCell id="loop_progress" value="loop" style="shape=umlFrame;whiteSpace=wrap;html=1;width=40;height=20;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=5;dashed=0;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="350" y="395" width="610" height="200" as="geometry"/>
        </mxCell>

        <!-- Loop Guard -->
        <mxCell id="guard_loop" value="[for each course in purchased list]" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=3;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="405" width="200" height="25" as="geometry"/>
        </mxCell>

        <!-- 9. :CourseController -> :LectureProgressDAO: courseCompletion(userId, courseId) -->
        <mxCell id="msg9" value="courseCompletion(userId, courseId)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="440" y="430" as="sourcePoint"/>
            <mxPoint x="760" y="430" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 10. :LectureProgressDAO -> Database: execute progress query -->
        <mxCell id="msg10" value="execute progress query" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="455" as="sourcePoint"/>
            <mxPoint x="910" y="455" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 11. Database -> :LectureProgressDAO: return progress statistics row -->
        <mxCell id="msg11" value="return progress statistics row" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="910" y="480" as="sourcePoint"/>
            <mxPoint x="760" y="480" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 12. :LectureProgressDAO -> :CourseController: return completion percent -->
        <mxCell id="msg12" value="return completion percent" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="505" as="sourcePoint"/>
            <mxPoint x="440" y="505" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 13. :CourseController -> :MyCoursesBoundary: renderCourses(coursesWithProgress) -->
        <mxCell id="msg13" value="renderCourses(coursesWithProgress)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="440" y="615" as="sourcePoint"/>
            <mxPoint x="265" y="615" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 14. :MyCoursesBoundary -> Student: display courses list -->
        <mxCell id="msg14" value="render course cards with progress bars on UI" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="265" y="640" as="sourcePoint"/>
            <mxPoint x="110" y="640" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ==================== NOTES ==================== -->
        <!-- Note: Exception details -->
        <mxCell id="note_exc" value="&lt;b&gt;Exception Flows:&lt;/b&gt;&#xa;2.1: Student chưa sở hữu khóa học nào trong hệ thống.&#xa;→ Hiển thị &quot;Bạn chưa sở hữu khóa học nào&quot; kèm nút chuyển hướng.&#xa;2.2: Nhấn &quot;Khám phá khóa học ngay&quot; $\rightarrow$ chuyển hướng về trang danh sách khóa học." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;align=left;spacingLeft=5;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="45" y="690" width="450" height="90" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
